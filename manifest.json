{
  "manifest_version": 3,
  "name": "Hub de Chamados - Holambra",
  "version": "1.7.1",
  "description": "Monitora chamados no GLPI, Evolutize e Movidesk (e fontes personalizadas que você cadastrar) e avisa (notificação + som) quando algo mudar.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "scripting", "tabs", "offscreen", "downloads", "permissions"],
  "host_permissions": [
    "http://chamadosti.holambra.corp/*",
    "https://suporte.evolutize.com.br/*",
    "https://keyrus-brasil.movidesk.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hub de Chamados (clique para abrir)"
  }
}
